                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.data && jsonData.data.url) {",
                      "        var url = new URL(jsonData.data.url, 'http://localhost');",
                      "        var token = url.searchParams.get('token');",
                      "        var parts = url.pathname.split('/');",
                      "        var fileKey = parts[parts.length - 1];",
                      "        if (token) pm.collectionVariables.set('storageToken', token);",
                      "        if (fileKey) pm.collectionVariables.set('fileKey', fileKey);",
                      "    }",
                      "}"
