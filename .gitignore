cat > .gitignore << 'EOF'
# ============
# Node.js / NestJS
# ============
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============
# Environment variables
# ============
.env
.env.*
!.env.example

# ============
# Prisma
# ============
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal
prisma/migrations/*.sqlite

# ============
# OS / Editor files
# ============
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
.vscode/
.idea/
*.swp
*.swo
*~
.vercel
.netlify

# ============
# Testing / Coverage
# ============
.nyc_output/
test/reports/
junit.xml

# ============
# Docker
# ============
*.pid
docker-compose.override.yml

# ============
# Temporary files
# ============
tmp/
temp/
*.tmp
.cache/
.pnpm-store/

# ============
# Agent-generated artifacts
# ============
.agents/
.omg/
.oma/

# ============
# Session artifacts
# ============
*-out*.txt
batch1-*.txt
batch-1-review.md
beh-*.txt
smoke-*.md
smoke-*.txt
seed_output.txt
backend_pid.txt
cookies.txt

# ============
# Patch files
# ============
*.patch
*.orig

# ============
# Ad-hoc scripts (root only)
# ============
/test-script.js
/test-script.ts
/test-auth-body.js
/test-db.js
/test-interceptor-patch.js
/test-login.js

/run_migrate.exp
/run_migrate.py
/levora_smoke.sh

/patch-*.js
/patch-*.py
/update_*.js
/add-*.js
/fix-*.js
/fix_*.js
/fix-collections.js

# ============
# Runtime
# ============
uploads/
logs/
EOF
