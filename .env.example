# ──────────────────────────────────────────────
# Environment Variables – Backend
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_NAME=my-app
API_PREFIX=api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_hub?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5000

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
# Comma-separated list of allowed origins for CSRF protection on refresh endpoint.
# Supports wildcards (e.g., https://*.example.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
JWT_SECRET=dev-only-secret-do-not-use-in-production!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Logging
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_FREQUENCY=daily
LOG_MAX_FILES=30

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# OAuth Token Encryption (64-character hex key for AES-256-CBC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Mail
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@afaq.local
MAIL_FROM_NAME="Afaq Dev"
MAIL_PREVIEW=true
APP_BASE_URL=http://localhost:3000
