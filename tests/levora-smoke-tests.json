        },
        {
          "name": "Data Minimization (GET /profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response does not contain sensitive auth fields', function () {",
                  "    var res = pm.response.text();",
                  "    pm.expect(res).to.not.include('\"password\"');",
                  "    pm.expect(res).to.not.include('\"hash\"');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
