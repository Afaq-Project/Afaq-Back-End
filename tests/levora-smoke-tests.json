                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Extract access token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.data.accessToken);",
                  "});",
                  "if (jsonData.data && jsonData.data.refreshToken) { pm.collectionVariables.set('refresh_token', jsonData.data.refreshToken); }"
                ],
                "type": "text/javascript"
              }
            }
